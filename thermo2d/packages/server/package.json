{
  "name": "@thermo2d/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "thermo2d MCP server (stdio) and CLI, bundled to single-file ESM for Node on Windows.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
